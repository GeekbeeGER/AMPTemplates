####################################
# RuneScape: Dragonwilds - AMP Generic Module Template
# Bezugsquelle: SteamCMD (AppID 4019830, anonymer Login)
# Offizielle Referenz: https://dragonwilds.runescape.wiki/w/Dedicated_Servers/Linux
####################################

## --- Application ---
App.DisplayName=RuneScape: Dragonwilds Dedicated Server
App.RootDir=
App.WorkingDir=
App.ExecutableLinux=RSDragonwildsServer.sh
App.ExecutableWin=RSDragonwildsServer.exe
App.Compatibility=1
App.CommandLineArgs=-log -NewConsole -Port={{$ApplicationPort1}} {{$FormattedArgs}}
App.ExitMethod=SIGTERM
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.ApplicationIPBinding=0.0.0.0
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationPort1=7777
App.MaxUsers=8
App.AdminMethod=STDIO
App.SteamUpdateAnonymousLogin=True
App.RapidStartup=False
# Aktualisierungs- und Start-Stages gemäß offiziellem Linux-Guide
App.UpdateSources=[{"UpdateStageName": "SteamCMD Download (AppID 4019830)", "UpdateSourcePlatform": "All", "UpdateSource": "SteamCMD", "UpdateSourceData": "4019830"}, {"UpdateStageName": "Startskript ausfuehrbar machen", "UpdateSourcePlatform": "Linux", "UpdateSource": "SetExecutableFlag", "UpdateSourceArgs": "RSDragonwildsServer.sh"}, {"UpdateStageName": "Ersten Start ausfuehren (generiert DedicatedServer.ini)", "UpdateSourcePlatform": "All", "UpdateSource": "StartApplication"}, {"UpdateStageName": "Auf Ready-Status warten", "UpdateSourcePlatform": "All", "UpdateSource": "WaitForStartupComplete"}, {"UpdateStageName": "Server wieder stoppen", "UpdateSourcePlatform": "All", "UpdateSource": "ShutdownApplication"}]

## --- Console ---
Console.AppReadyRegex=^.*(?:Server is ready|Listening on port|World .* loaded).*$

## --- Meta ---
GenericModule.Meta.DisplayName=RuneScape: Dragonwilds
GenericModule.Meta.Description=RuneScape Dragonwilds Dedicated Server Template for AMP
GenericModule.Meta.OS=Linux,Windows
GenericModule.Meta.Arch=x86_64
GenericModule.Meta.MinAMPVersion=2.3.0.0
GenericModule.Meta.AppConfigId=8763fd76-1ed5-4a10-9326-11510465a0e9
GenericModule.Meta.Author=Community
GenericModule.Meta.URL=https://dragonwilds.runescape.wiki/w/Dedicated_Servers
GenericModule.Meta.DisplayImageSource=steam:4019830
GenericModule.Meta.EndpointURIFormat=
GenericModule.Meta.ConfigManifest=dragonwildsconfig.json
GenericModule.Meta.MetaConfigManifest=dragonwildsmetaconfig.json
GenericModule.Meta.ConfigRoot=dragonwilds.kvp
GenericModule.Meta.ContainerPolicy=NoPreference
