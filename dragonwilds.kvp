####################################
# Dragonwilds - AMP Generic Module Template
# Referenz: Angepasst für AMP Generic Module
####################################

## --- Application ---
App.DisplayName=Dragonwilds Dedicated Server
App.RootDir=
App.WorkingDir=
App.ExecutableLinux=
App.ExecutableWin=
App.Compatibility=1
App.CommandLineArgs=
App.MonitorChildProcessName=
App.ExitMethod=String
App.ExitString=quit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.ApplicationIPBinding=0.0.0.0
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationPort1=7777
App.ApplicationPort2=27015
App.MaxUsers=16
App.AdminMethod=STDIO
App.SteamUpdateAnonymousLogin=False
App.RapidStartup=False
App.UpdateSources=[]

## --- Console ---
Console.AppReadyRegex=^.*Server Initialization Complete.*$
Console.UserJoinRegex=^.*?(?<username>.+?)\s+joined.*$
Console.UserLeaveRegex=^.*?(?<username>.+?)\s+left.*$

## --- Meta ---
